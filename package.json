{
  "name": "todo-webapp-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack ToDo web application built with React, Express, MongoDB, and JWT authentication.",
  "type": "module",
  "scripts": {
    "dev": "parcel ./src/index.html --port 1234",
    "build": "parcel build ./src/index.html --dist-dir dist --no-cache",
    "start": "node app.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
